# VSign LIVE production — copy values into Backend/services/e-sign-service/.env
# Never commit real passwords. Use: node scripts/switch-vsign-env.js live

VSIGN_ACTIVE_PROFILE=live
VSIGN_ENV=production
VSIGN_CERT_MODE=live
ASP_ID=IIPL001

VSIGN_AUTHPAGE=https://esign.verasys.in/esp
# OTP page logo = website branding (Supabase branding/logo) — same as esp.documantra.in.
# Optional override only: BRAND_LOGO_URL=https://...
# VSIGN_AUTH_LOGO_URL is ignored; do not set a separate auth logo.
VSIGN_ESP_RESPONSE_URL=https://esign.verasys.in/esign/2.1/signature
VSIGN_CALLBACK_URL=https://esp.documantra.in/esign/api/e-sign/public/v-sign/response

# VSign ESP Utility (Java 8 JAR on same host as e-sign)
# Host install: http://127.0.0.1:7078
# Docker e-sign → host utility: http://host.docker.internal:7078
UTILITY_URL=http://127.0.0.1:7078
VSIGN_USE_JAR=1
VSIGN_APPEARANCE_MODE=custom-tick
VSIGN_SIGNATURE_FONT_SIZE=10

PFX_PATH=uploads/vSign/signCertificate.pfx
PFX_PASSWORD=
PFX_ALIAS=
DM_ENCRYPTION_KEY_PATH=uploads/vSign/dm_encryption_key.pfx

# isresponseXML=1 is set in code — VSign POSTs full EsignResp to callback URL above.
