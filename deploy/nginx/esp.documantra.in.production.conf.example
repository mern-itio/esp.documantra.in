# Production reference for esp.documantra.in (DigitalOcean / host nginx).
# Copy relevant blocks into /etc/nginx/sites-enabled/esp.documantra.in
#
# FIX 413 on /esign/api/e-sign/upload:
#   client_max_body_size 100M;  (required in EACH server { } block — http + https)

server {
    listen 80;
    listen [::]:80;
    server_name esp.documantra.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name esp.documantra.in;

    server_tokens off;

    # VAPT L18/L19 — custom error pages (static files from frontend dist)
    error_page 404 /404.html;
    error_page 502 503 504 /502.html;

    # VAPT L23/L28 — strip upstream + nginx Server banner (see snippets/vapt-hide-server-header.conf)
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;
    include /etc/nginx/snippets/vapt-hide-server-header.conf;

    # Allow PDF uploads up to 50MB (multer limit) with headroom for multipart overhead
    client_max_body_size 100M;

    ssl_certificate     /etc/letsencrypt/live/esp.documantra.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/esp.documantra.in/privkey.pem;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;

    # Compress text assets — critical for ~11MB JS bundle on first load
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml
        image/svg+xml;

    # VAPT L22/L25 — security headers (server block only; do NOT repeat HSTS in location {})
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' blob: https://esp.documantra.in wss://esp.documantra.in https://accounts.google.com https://api.ipify.org https://tgkqdagmnbgmrtjpymbz.supabase.co; worker-src 'self' blob:; media-src 'self' data:; frame-src 'self' https://accounts.google.com https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    location /auth/ {
        if ($request_method = OPTIONS) { return 405; }
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
        proxy_pass http://127.0.0.1:2101/;
    }

    # Surepass DigiLocker webhook (identity-service) — do not remove
    location ^~ /webhook/surepass-digilocker {
        proxy_pass http://127.0.0.1:2114/webhook/surepass-digilocker;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /identity/ {
        proxy_pass http://127.0.0.1:2114/;
    }

    location /document/ {
        proxy_pass http://127.0.0.1:2102/;
    }

    location /esign/ {
        client_max_body_size 100M;
        proxy_pass http://127.0.0.1:2103/;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:2103/uploads/;
    }

    location /pdf/ {
        proxy_pass http://127.0.0.1:2104/;
    }

    location /service/ {
        proxy_pass http://127.0.0.1:2105/;
    }

    location /template/ {
        proxy_pass http://127.0.0.1:2106/;
    }

    location /support/ {
        proxy_pass http://127.0.0.1:2107/;
    }

    location /ai/ {
        proxy_pass http://127.0.0.1:2108/;
    }

    location /subscription/ {
        proxy_pass http://127.0.0.1:2110/;
    }

    location /organization/ {
        proxy_pass http://127.0.0.1:2111/;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:2113/api/;
    }

    location /service/admin/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        proxy_pass http://127.0.0.1:3100/;
    }

    # Admin SPA — separate repo (Draft-and-Sign-Admin-Frontend), build → /var/www/admin-esp
    location /admin/ {
        if ($request_method = OPTIONS) { return 405; }
        alias /var/www/admin-esp/;
        try_files $uri $uri/ /admin/index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        include /etc/nginx/snippets/vapt-admin-spa-headers.conf;
    }

    location = /admin/index.html {
        if ($request_method = OPTIONS) { return 405; }
        alias /var/www/admin-esp/index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        include /etc/nginx/snippets/vapt-admin-spa-headers.conf;
    }

    # Legacy / scanner paths → SPA (no OPTIONS enumeration)
    location = /auth-login {
        if ($request_method = OPTIONS) { return 405; }
        return 301 /login;
    }

    # RFC 9116 security contact (VAPT LOW)
    location = /security.txt {
        root /var/www/draft-and-sign;
        default_type text/plain;
    }

    location ^~ /.well-known/ {
        root /var/www/draft-and-sign;
        default_type text/plain;
    }

    location = /index.html {
        if ($request_method = OPTIONS) { return 405; }
        root /var/www/draft-and-sign;
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        include /etc/nginx/snippets/vapt-user-spa-headers.conf;
    }

    # Hashed Vite assets — long cache (filename changes on each build)
    location ^~ /assets/ {
        root /var/www/draft-and-sign;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # Static media/fonts — moderate cache
    location ~* \.(avif|webp|woff2?|ttf|svg|ico|mp4|mjs)$ {
        root /var/www/draft-and-sign;
        expires 30d;
        add_header Cache-Control "public" always;
        try_files $uri =404;
    }

    location = /404.html {
        internal;
        root /var/www/draft-and-sign;
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
    }

    location = /502.html {
        internal;
        root /var/www/draft-and-sign;
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
    }

    location = / {
        if ($request_method = OPTIONS) { return 405; }
        root /var/www/draft-and-sign;
        try_files /index.html =404;
        include /etc/nginx/snippets/vapt-user-spa-headers.conf;
    }

    location / {
        if ($request_method = OPTIONS) { return 405; }
        root /var/www/draft-and-sign;
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/vapt-user-spa-headers.conf;
    }
}