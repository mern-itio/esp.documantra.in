# Step 1 — HTTP only (before SSL cert exists). Use this FIRST, then certbot, then swap to
# esign.documantra.in.production.conf.example
#
#   cp deploy/nginx/esign.documantra.in.bootstrap.conf.example /etc/nginx/sites-enabled/esign.documantra.in
#   nginx -t && systemctl reload nginx
#   certbot certonly --webroot -w /var/www/esign-public -d esign.documantra.in
#   cp deploy/nginx/esign.documantra.in.production.conf.example /etc/nginx/sites-enabled/esign.documantra.in
#   nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name esign.documantra.in;

    server_tokens off;
    client_max_body_size 100M;

    root /var/www/esign-public;

    location ^~ /.well-known/acme-challenge/ {
        allow all;
        default_type "text/plain";
        try_files $uri =404;
    }

    location /esign/ {
        client_max_body_size 100M;
        if ($request_method = OPTIONS) { return 405; }
        proxy_pass http://127.0.0.1:2103/;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:2103/uploads/;
    }

    location = / {
        return 302 /public-sign;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
