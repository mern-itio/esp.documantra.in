# Public sign only — https://esign.documantra.in
# DNS: A record esign.documantra.in → server IP
# SSL: certbot -d esign.documantra.in

server {
    listen 80;
    listen [::]:80;
    server_name esign.documantra.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name esign.documantra.in;

    server_tokens off;
    client_max_body_size 100M;

    ssl_certificate     /etc/letsencrypt/live/esign.documantra.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/esign.documantra.in/privkey.pem;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;

    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;
    include /etc/nginx/snippets/vapt-hide-server-header.conf;

    error_page 404 /404.html;
    error_page 502 503 504 /502.html;

    # e-sign API (public wizard + editor)
    location /esign/ {
        client_max_body_size 100M;
        if ($request_method = OPTIONS) { return 405; }
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
        proxy_pass http://127.0.0.1:2103/;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:2103/uploads/;
    }

    location = / {
        if ($request_method = OPTIONS) { return 405; }
        return 302 /public-sign;
    }

    location = /index.html {
        if ($request_method = OPTIONS) { return 405; }
        root /var/www/esign-public;
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        include /etc/nginx/snippets/vapt-esign-public-spa-headers.conf;
    }

    location = /404.html {
        internal;
        root /var/www/esign-public;
    }

    location = /502.html {
        internal;
        root /var/www/esign-public;
    }

    location / {
        if ($request_method = OPTIONS) { return 405; }
        root /var/www/esign-public;
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/vapt-esign-public-spa-headers.conf;
    }
}
