{
  "watch": [
    "controllers",
    "routes",
    "middleware",
    "config",
    "models",
    "utils",
    "index.js"
  ],
  "ignore": [
    "uploads/**/*",
    "outputs/**/*",
    "temp/**/*",
    "temp/**",
    "temp-images/**/*",
    "epubs/**/*",
    "images/**/*",
    "scripts/**/*",
    "public/**/*",
    "node_modules/**/*",
    "*.log",
    "*.pdf",
    "*.json.tmp",
    "edits-*.json",
    "edited-*.pdf",
    "test_*.json",
    "test_*.pdf",
    "**/temp/**",
    "**/uploads/**",
    "**/outputs/**"
  ],
  "ext": "js,json",
  "delay": 2000,
  "verbose": true
}