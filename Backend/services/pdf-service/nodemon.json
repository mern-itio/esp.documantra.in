{
  "watch": ["."],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "uploads",
    "outputs", 
    "temp-images",
    "permissions",
    "images",
    "epubs",
    "edited",
    "uploaded_images",
    "data/templates",
    "certificates",
    "*.log",
    "*.tmp"
  ],
  "exec": "node index.js",
  "legacyWatch": true
}
