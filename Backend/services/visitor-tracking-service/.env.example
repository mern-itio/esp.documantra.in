PORT=2116
NODE_ENV=development

# Dedicated Visitor Tracking PostgreSQL (never the master MongoDB)
TRACKING_DATABASE_URL=postgres://tracking:tracking@visitor-tracking-postgres:5432/visitor_tracking

# Shared secret for auth-service → link-customer / admin internal calls
TRACKING_INTERNAL_SECRET=change-me-tracking-internal-secret

# Cookie / session
SESSION_TIMEOUT_MINUTES=30
TRACKING_RETENTION_DAYS=90
RETENTION_CRON_MS=86400000

# CORS origins (comma-separated)
TRACKING_CORS_ORIGINS=https://documantra.in,https://www.documantra.in,https://esp.documantra.in,http://localhost:5173,http://localhost:3000
